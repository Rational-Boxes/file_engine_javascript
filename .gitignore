.idea/
# Default ignored files
/shelf/
/workspace.xml
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml
node_modules/
/dist/

# Secrets live in .env files, and .env files never go into git.
# Templates are the deliberate exception: they carry placeholders, not values.
.env
.env.*
!.env.example
!.env-default
